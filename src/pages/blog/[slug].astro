---
import { getCollection, render } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import ArticleCover from '@/components/blog/ArticleCover.astro';
import ArticleSidebar from '@/components/blog/ArticleSidebar.astro';
import RelatedArticles from '@/components/blog/RelatedArticles.astro';
import {
  formatPublishDate,
  getRelatedPosts,
  sortPostsByDate,
} from '@/data/blog';
import { buildCanonicalUrl } from '@/utils/seo';
import { SITE } from '@/lib/constants';
import '@/styles/blog-prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = sortPostsByDate(
  await getCollection('blog', ({ data }) => !data.draft),
);
const related = getRelatedPosts(allPosts, post, 3);
const canonical = buildCanonicalUrl(`/blog/${post.id}`);

const articleJsonLd = {
  type: 'BlogPosting',
  data: {
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
    author: {
      '@type': 'Organization',
      name: post.data.author,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/og-default.png`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonical,
    },
    image: `${SITE.url}/og-default.png`,
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    inLanguage: 'en-US',
  },
};

const breadcrumbJsonLd = {
  type: 'BreadcrumbList',
  data: {
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: buildCanonicalUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Insights',
        item: buildCanonicalUrl('/blog'),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: canonical,
      },
    ],
  },
};
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  seo={{
    canonical,
    keywords: post.data.tags,
    openGraph: {
      title: post.data.title,
      description: post.data.description,
      url: canonical,
      type: 'article',
      publishedTime: post.data.publishDate.toISOString(),
      modifiedTime: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
      authors: [post.data.author],
      section: post.data.category,
      tags: post.data.tags,
    },
    twitter: {
      title: post.data.title,
      description: post.data.description,
    },
    jsonLd: [articleJsonLd, breadcrumbJsonLd],
  }}
>
  <article class="relative overflow-hidden pt-24 md:pt-28" data-article-page>
    <Container class="relative z-10 pb-16 md:pb-24">
      <header class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-none lg:text-left">
        <Badge variant="secondary" class="normal-case tracking-[0.08em]">
          {post.data.category}
        </Badge>

        <h1 class="font-display mt-5 text-3xl tracking-tight text-foreground md:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>

        <p class="text-body-lg mx-auto mt-5 max-w-2xl text-pretty lg:mx-0">
          {post.data.description}
        </p>

        <dl class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-muted lg:justify-start">
          <div>
            <dt class="sr-only">Author</dt>
            <dd>{post.data.author}</dd>
          </div>
          <div>
            <dt class="sr-only">Published</dt>
            <dd>
              <time datetime={post.data.publishDate.toISOString()}>
                {formatPublishDate(post.data.publishDate)}
              </time>
            </dd>
          </div>
          <div>
            <dt class="sr-only">Reading time</dt>
            <dd>{post.data.readingTime}</dd>
          </div>
        </dl>
      </header>

      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-[var(--radius-ds)]">
        <ArticleCover
          variant={post.data.coverVariant}
          title={post.data.category}
          class="aspect-[21/9]"
        />
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-14">
        <div class="blog-prose mx-auto w-full max-w-[800px] lg:mx-0">
          <Content />
        </div>

        <div class="hidden lg:block">
          <div class="sticky top-28">
            <ArticleSidebar headings={headings} />
          </div>
        </div>
      </div>
    </Container>
  </article>

  <RelatedArticles posts={related} />
</MainLayout>
