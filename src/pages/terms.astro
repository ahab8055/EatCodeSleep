---
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import { buildCanonicalUrl } from '@/utils/seo';

const canonical = buildCanonicalUrl('/terms');
const updated = 'July 14, 2026';
---

<MainLayout
  title="Terms of Use"
  description="Terms governing use of the EatCodeSleep website and general engagement for services."
  seo={{
    canonical,
    keywords: ['terms of use', 'EatCodeSleep', 'website terms'],
    openGraph: {
      title: 'Terms of Use',
      description: 'Terms governing use of the EatCodeSleep website.',
      url: canonical,
      type: 'website',
    },
  }}
>
  <section class="relative overflow-hidden pt-24 md:pt-28" aria-labelledby="terms-heading">
    <Container class="relative z-10 max-w-3xl pb-20 md:pb-28">
      <p class="text-label text-secondary">Legal</p>
      <Heading as={1} size="lg" id="terms-heading" class="mt-4">
        Terms of Use
      </Heading>
      <p class="mt-4 text-muted">Last updated: {updated}</p>

      <div class="prose-legal mt-10 space-y-8 text-muted">
        <section>
          <h2 class="font-display text-xl text-foreground">Acceptance</h2>
          <p class="mt-3 leading-relaxed">
            By using eatcodesleep.org you agree to these terms. If you do not agree, please do not use
            the site.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl text-foreground">Website content</h2>
          <p class="mt-3 leading-relaxed">
            Site content is for general information about EatCodeSleep and our services. It is not a
            proposal, guarantee, or professional advice for your specific situation. Project scope,
            pricing, and deliverables are defined only in a signed agreement.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl text-foreground">Acceptable use</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">
            <li>Do not attempt to disrupt or abuse the website or related systems.</li>
            <li>Do not submit unlawful, deceptive, or harmful content through forms.</li>
            <li>Do not scrape the site in a way that degrades performance or violates robots rules.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-display text-xl text-foreground">Intellectual property</h2>
          <p class="mt-3 leading-relaxed">
            Branding, copy, and design on this site belong to EatCodeSleep or its licensors. You may
            not copy or reuse them commercially without permission.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl text-foreground">Limitation of liability</h2>
          <p class="mt-3 leading-relaxed">
            The website is provided “as is.” To the fullest extent permitted by law, EatCodeSleep is
            not liable for damages arising from use of or inability to use the site.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl text-foreground">Changes</h2>
          <p class="mt-3 leading-relaxed">
            We may update these terms from time to time. Continued use of the site after changes means
            you accept the revised terms.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl text-foreground">Contact</h2>
          <p class="mt-3 leading-relaxed">
            Questions: <a
              class="text-secondary underline-offset-4 hover:underline"
              href="mailto:hello@eatcodesleep.com">hello@eatcodesleep.com</a
            >.
          </p>
        </section>
      </div>
    </Container>
  </section>
</MainLayout>
