---
/**
 * Soft atmosphere for contact page sections.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="contact-bg absolute inset-0"></div>
  <div class="contact-grid absolute inset-0 opacity-[0.14]"></div>
  <div
    class="absolute left-1/2 top-0 size-[32rem] -translate-x-1/2 rounded-full bg-primary/12 blur-[120px] gpu md:size-[40rem]"
    data-contact-glow
  >
  </div>
  <div
    class="absolute bottom-[12%] right-[-8%] size-[20rem] rounded-full bg-secondary/10 blur-[100px] gpu"
    data-contact-glow
  >
  </div>
</div>

<style>
  .contact-bg {
    background:
      radial-gradient(ellipse 55% 38% at 50% 0%, rgb(79 70 229 / 0.12), transparent 55%),
      radial-gradient(ellipse 40% 30% at 88% 72%, rgb(6 182 212 / 0.07), transparent 50%),
      linear-gradient(180deg, #050816 0%, #0b1023 50%, #050816 100%);
  }

  .contact-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.02) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 35%, black 12%, transparent 75%);
  }
</style>
