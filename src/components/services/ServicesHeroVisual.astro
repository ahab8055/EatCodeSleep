---
const nodes = [
  { id: 'problem', label: 'Business Problem' },
  { id: 'architecture', label: 'Software Architecture' },
  { id: 'ai', label: 'AI Layer' },
  { id: 'automation', label: 'Automation' },
  { id: 'cloud', label: 'Cloud Infrastructure' },
] as const;
---

<div
  class="relative mx-auto w-full max-w-md"
  data-services-hero-visual
  data-services-float
  aria-hidden="true"
>
  <div
    class="absolute left-1/2 top-1/2 size-[70%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/18 blur-[90px]"
    data-services-glow
  >
  </div>

  <div
    class="relative overflow-hidden rounded-[var(--radius-ds)] border border-border bg-background-card/60 p-5 backdrop-blur-xl sm:p-6"
  >
    <p class="text-label mb-5 text-secondary">Service Ecosystem</p>

    <ol class="relative space-y-0">
      {
        nodes.map((node, index) => (
          <li class="relative" data-ecosystem-node>
            {index < nodes.length - 1 && (
              <span class="ecosystem-connector absolute left-[1.15rem] top-10 bottom-0 w-px" />
            )}
            <div class="relative z-10 flex items-center gap-3">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-border bg-background-secondary text-xs text-secondary">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="flex min-w-0 flex-1 items-center rounded-xl border border-border bg-white/[0.03] px-3 py-2.5">
                <span class="truncate text-sm text-foreground">{node.label}</span>
              </div>
            </div>
            {index < nodes.length - 1 && (
              <div class="flex justify-center py-1.5 pl-1" aria-hidden="true">
                <span class="text-xs text-muted/70">↓</span>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .ecosystem-connector {
    background: linear-gradient(
      180deg,
      rgb(6 182 212 / 0.65),
      rgb(79 70 229 / 0.35),
      rgb(255 255 255 / 0.08)
    );
  }
</style>
