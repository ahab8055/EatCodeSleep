---
import { BrainCircuit, Check, Monitor, Server, Smartphone, Workflow } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import ServiceVisualization from '@/components/services/ServiceVisualization.astro';
import { cn } from '@/lib/cn';
import type { ServiceDetail, ServiceIconName } from '@/types/services-page';

export interface Props {
  service: ServiceDetail;
  reverse?: boolean;
  isFirst?: boolean;
}

const { service, reverse = false, isFirst = false }: Props = Astro.props;

const icons: Record<ServiceIconName, typeof Monitor> = {
  monitor: Monitor,
  'brain-circuit': BrainCircuit,
  smartphone: Smartphone,
  workflow: Workflow,
  server: Server,
};

const Icon = icons[service.icon];
---

<section
  id={service.id}
  class={cn(
    'service-section scroll-mt-[calc(4rem+3.25rem)] py-12 md:scroll-mt-[calc(5rem+3.5rem)] md:py-16 lg:py-20',
    !isFirst && 'border-t border-border/50',
  )}
  aria-labelledby={`${service.id}-heading`}
  data-service-section
>
  {
    service.aliases?.map((alias) => (
      <div id={alias} class="sr-only" tabindex="-1" />
    ))
  }

  <Container>
    <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12 xl:gap-16">
      <div class={cn('min-w-0', reverse && 'lg:order-2')} data-service-content>
        <div class="mb-4 inline-flex size-10 items-center justify-center rounded-xl border border-border bg-white/5 text-secondary md:mb-5 md:size-11">
          <Icon class="size-5" aria-hidden="true" />
        </div>

        <h2
          id={`${service.id}-heading`}
          class="font-display text-2xl tracking-tight text-foreground md:text-3xl"
        >
          {service.title}
        </h2>

        <p class="mt-3 text-sm font-medium text-secondary md:text-base">{service.problem}</p>
        <p class="text-body mt-4 max-w-xl text-pretty">{service.description}</p>

        <div class="mt-7 space-y-6 md:mt-8">
          <div>
            <h3 class="text-label text-muted">What we build</h3>
            <ul class="mt-3 grid gap-2.5 sm:grid-cols-2" role="list">
              {
                service.solutions.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <Check
                      class="mt-0.5 size-3.5 shrink-0 text-accent"
                      stroke-width={2.5}
                      aria-hidden="true"
                    />
                    <span class="text-foreground/85">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="text-label text-muted">Typical deliverables</h3>
            <ul class="mt-3 grid gap-2.5 sm:grid-cols-2" role="list">
              {
                service.deliverables.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <Check
                      class="mt-0.5 size-3.5 shrink-0 text-accent"
                      stroke-width={2.5}
                      aria-hidden="true"
                    />
                    <span class="text-foreground/85">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <ul class="mt-7 flex flex-wrap gap-2 md:mt-8" aria-label={`${service.title} technologies`}>
          {
            service.technologies.map((tech) => (
              <li>
                <TechBadge class="border-white/10 bg-white/[0.07] text-foreground/90">
                  {tech}
                </TechBadge>
              </li>
            ))
          }
        </ul>

        <div class="mt-7 md:mt-8">
          <Button href={service.ctaHref} size="md">
            {service.ctaLabel}
          </Button>
        </div>
      </div>

      <div class={cn('min-w-0 lg:sticky lg:top-[calc(5rem+3.5rem+1rem)]', reverse && 'lg:order-1')}>
        <ServiceVisualization visual={service.visual} />
      </div>
    </div>
  </Container>
</section>
