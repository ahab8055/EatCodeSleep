---
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import AboutBackground from '@/components/about/AboutBackground.astro';
import { aboutTechCategories, aboutTechCriteria } from '@/data/about';
---

<Section
  id="technology-mindset"
  spacing="xl"
  class="scroll-mt-28 overflow-hidden"
  ariaLabelledby="technology-mindset-heading"
  data-about-tech
>
  <AboutBackground />

  <Container class="relative z-10">
    <SectionHeading
      label="Technology Mindset"
      heading={['Technology is a tool,', 'not the destination.']}
      description="We select technologies based on the outcome you need—not the trend of the week."
      headingId="technology-mindset-heading"
      class="mb-10 md:mb-12"
    />

    <ul
      class="mb-10 flex flex-wrap gap-2 md:mb-12"
      data-tech-criteria
      aria-label="Technology selection criteria"
    >
      {
        aboutTechCriteria.map((item) => (
          <li
            class="rounded-full border border-border bg-white/5 px-3.5 py-1.5 text-sm text-muted"
            data-tech-criterion
          >
            {item}
          </li>
        ))
      }
    </ul>

    <ul
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6"
      data-tech-categories
      role="list"
    >
      {
        aboutTechCategories.map((category) => (
          <li class="min-w-0" data-tech-category>
            <article class="h-full rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-5 backdrop-blur-xl transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-white/15 sm:p-6">
              <h3 class="font-display text-lg tracking-tight text-foreground">
                {category.title}
              </h3>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${category.title} technologies`}>
                {category.items.map((item) => (
                  <li>
                    <TechBadge class="border-white/10 bg-white/[0.07] text-foreground/90">
                      {item}
                    </TechBadge>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
