---
import { Brain, CodeXml, Handshake, Rocket, Shield, Users } from '@lucide/astro';
import { cn } from '@/lib/cn';
import type { AboutValue, AboutValueIcon } from '@/types/about';

export interface Props {
  value: AboutValue;
  class?: string;
}

const { value, class: className }: Props = Astro.props;

const icons: Record<AboutValueIcon, typeof CodeXml> = {
  code: CodeXml,
  brain: Brain,
  users: Users,
  shield: Shield,
  handshake: Handshake,
  rocket: Rocket,
};

const Icon = icons[value.icon];
---

<article
  class={cn(
    'flex h-full flex-col rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-5 backdrop-blur-xl transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-white/15 hover:shadow-[0_20px_50px_rgb(0_0_0_/0.3),0_0_30px_rgb(79_70_229_/0.1)] sm:p-6',
    className,
  )}
  data-value-card
>
  <div class="mb-4 inline-flex size-10 items-center justify-center rounded-xl border border-border bg-white/5 text-secondary">
    <Icon class="size-5" aria-hidden="true" />
  </div>
  <h3 class="font-display text-lg tracking-tight text-foreground">{value.title}</h3>
  <p class="text-body-sm mt-2 flex-1 text-pretty">{value.description}</p>
</article>
