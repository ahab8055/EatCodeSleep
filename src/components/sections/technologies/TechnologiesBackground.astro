---
/**
 * Soft atmosphere for Technologies section.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="tech-bg-base absolute inset-0"></div>
  <div class="tech-bg-grid absolute inset-0 opacity-[0.16]"></div>
  <div class="tech-bg-noise absolute inset-0 opacity-[0.28] mix-blend-overlay"></div>

  <div
    class="absolute left-1/2 top-0 size-[32rem] -translate-x-1/2 rounded-full bg-primary/12 blur-[120px] gpu md:size-[40rem]"
    data-tech-glow
  >
  </div>
  <div
    class="absolute bottom-[10%] right-[-8%] size-[22rem] rounded-full bg-secondary/10 blur-[100px] gpu"
    data-tech-glow
  >
  </div>

  <span class="tech-particle tech-particle-1" data-tech-particle></span>
  <span class="tech-particle tech-particle-2" data-tech-particle></span>
  <span class="tech-particle tech-particle-3" data-tech-particle></span>
  <span class="tech-particle tech-particle-4" data-tech-particle></span>
  <span class="tech-particle tech-particle-5" data-tech-particle></span>
</div>

<style>
  .tech-bg-base {
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgb(79 70 229 / 0.12), transparent 55%),
      radial-gradient(ellipse 45% 35% at 90% 70%, rgb(6 182 212 / 0.08), transparent 50%),
      linear-gradient(180deg, #050816 0%, #0b1023 48%, #050816 100%);
  }

  .tech-bg-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 15%, transparent 75%);
  }

  .tech-bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }

  .tech-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.35);
    transform: translateZ(0);
  }

  .tech-particle-1 {
    left: 14%;
    top: 22%;
    opacity: 0.28;
  }
  .tech-particle-2 {
    left: 32%;
    top: 68%;
    opacity: 0.2;
  }
  .tech-particle-3 {
    left: 58%;
    top: 18%;
    opacity: 0.26;
  }
  .tech-particle-4 {
    left: 74%;
    top: 46%;
    opacity: 0.22;
  }
  .tech-particle-5 {
    left: 88%;
    top: 76%;
    opacity: 0.18;
  }
</style>
