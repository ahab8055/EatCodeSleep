---
import {
  BrainCircuit,
  Cloud,
  Monitor,
  Server,
  ShieldCheck,
  Workflow,
} from '@lucide/astro';
import TechnologyBadge from '@/components/sections/technologies/TechnologyBadge.astro';
import { cn } from '@/lib/cn';
import type { TechnologyCategory, TechnologyCategoryIcon } from '@/types/technologies';

export interface Props {
  category: TechnologyCategory;
  class?: string;
}

const { category, class: className }: Props = Astro.props;

const icons: Record<TechnologyCategoryIcon, typeof Monitor> = {
  monitor: Monitor,
  server: Server,
  'brain-circuit': BrainCircuit,
  cloud: Cloud,
  workflow: Workflow,
  'shield-check': ShieldCheck,
};

const Icon = icons[category.icon];
---

<article
  class={cn(
    'tech-category group relative h-full rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-6 backdrop-blur-xl transition-[transform,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:border-white/15 hover:shadow-[0_20px_50px_rgb(0_0_0_/0.35),0_0_40px_rgb(79_70_229_/0.12)] sm:p-7',
    className,
  )}
  data-tech-category
>
  <div
    class="mb-5 inline-flex size-12 items-center justify-center rounded-[calc(var(--radius-ds)-4px)] border border-border bg-white/5 text-secondary transition-transform duration-300 ease-out group-hover:rotate-6"
  >
    <Icon class="size-5" aria-hidden="true" />
  </div>

  <h3 class="font-display text-xl tracking-tight text-foreground">
    {category.title}
  </h3>

  <p class="text-body-sm mt-2 text-pretty">
    {category.description}
  </p>

  <ul
    class="mt-5 flex flex-wrap gap-2"
    aria-label={`${category.title} technologies`}
  >
    {
      category.technologies.map((tech) => (
        <li>
          <TechnologyBadge
            tone={tech.tone}
            class="group-hover:border-white/15 group-hover:text-foreground/90"
          >
            {tech.label}
          </TechnologyBadge>
        </li>
      ))
    }
  </ul>
</article>
