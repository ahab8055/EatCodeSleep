---
import { technologyMarqueeItems } from '@/data/technologies';
import { cn } from '@/lib/cn';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

/** Duplicate the list so CSS marquee can loop seamlessly. */
const loopItems = [...technologyMarqueeItems, ...technologyMarqueeItems];
---

<div
  class={cn(
    'tech-marquee relative overflow-hidden rounded-[var(--radius-ds)] border border-border bg-background-card/30 py-4 backdrop-blur-xl',
    className,
  )}
  data-tech-marquee
  role="presentation"
  aria-hidden="true"
>
  <div class="tech-marquee__fade tech-marquee__fade--left"></div>
  <div class="tech-marquee__fade tech-marquee__fade--right"></div>

  <div class="tech-marquee__track">
    <ul class="tech-marquee__list">
      {
        loopItems.map((item) => (
          <li class="tech-marquee__item">
            <span class="size-1.5 shrink-0 rounded-full bg-secondary/80" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<p class="sr-only">
  Technologies we work with include {technologyMarqueeItems.join(', ')}.
</p>

<style>
  .tech-marquee__track {
    overflow: hidden;
  }

  .tech-marquee__list {
    display: flex;
    width: max-content;
    align-items: center;
    animation: tech-marquee-scroll 42s linear infinite;
  }

  .tech-marquee:hover .tech-marquee__list {
    animation-play-state: paused;
  }

  .tech-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-inline: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .tech-marquee__item + .tech-marquee__item::before {
    content: '/';
    margin-right: 1.25rem;
    color: rgb(255 255 255 / 0.16);
  }

  .tech-marquee__fade {
    pointer-events: none;
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 4rem;
  }

  .tech-marquee__fade--left {
    left: 0;
    background: linear-gradient(90deg, rgb(5 8 22 / 0.95), transparent);
  }

  .tech-marquee__fade--right {
    right: 0;
    background: linear-gradient(270deg, rgb(5 8 22 / 0.95), transparent);
  }

  @keyframes tech-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-marquee__list {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
      row-gap: 0.75rem;
    }

    .tech-marquee__item + .tech-marquee__item::before {
      content: none;
      margin: 0;
    }
  }
</style>
