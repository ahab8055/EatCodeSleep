---
import { cn } from '@/lib/cn';
import type { TechnologyTone } from '@/types/technologies';

export interface Props {
  tone?: TechnologyTone;
  class?: string;
}

const { tone = 'muted', class: className }: Props = Astro.props;

const toneClasses: Record<TechnologyTone, string> = {
  primary: 'bg-primary',
  secondary: 'bg-secondary',
  accent: 'bg-accent',
  muted: 'bg-muted',
};
---

<span
  class={cn(
    'tech-item-badge inline-flex items-center gap-2 rounded-full border border-border bg-white/5 px-2.5 py-1 text-xs font-medium text-muted transition-all duration-300 ease-out hover:border-white/15 hover:text-foreground',
    className,
  )}
  data-technology-badge
>
  <span
    class={cn('size-1.5 shrink-0 rounded-full', toneClasses[tone])}
    aria-hidden="true"
  ></span>
  <slot />
</span>
