---
import { Blocks, FileCode, Gauge, Shield } from '@lucide/astro';
import { cn } from '@/lib/cn';
import type { EngineeringPrinciple, EngineeringPrincipleIcon } from '@/types/technologies';

export interface Props {
  principle: EngineeringPrinciple;
  class?: string;
}

const { principle, class: className }: Props = Astro.props;

const icons: Record<EngineeringPrincipleIcon, typeof Gauge> = {
  gauge: Gauge,
  blocks: Blocks,
  shield: Shield,
  'file-code': FileCode,
};

const Icon = icons[principle.icon];
---

<article
  class={cn(
    'rounded-[var(--radius-ds)] border border-border bg-background-card/40 p-5 backdrop-blur-xl sm:p-6',
    className,
  )}
  data-engineering-principle
>
  <div
    class="mb-4 inline-flex size-10 items-center justify-center rounded-full border border-border bg-white/5 text-secondary"
  >
    <Icon class="size-4" aria-hidden="true" />
  </div>

  <h3 class="font-display text-lg tracking-tight text-foreground">
    {principle.title}
  </h3>

  <p class="text-body-sm mt-2 text-pretty">
    {principle.description}
  </p>
</article>
