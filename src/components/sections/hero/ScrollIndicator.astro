---
import { ChevronDown } from '@lucide/astro';
---

<a
  href="#services"
  class="group absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-muted transition-colors duration-200 hover:text-foreground focus-visible:text-foreground md:bottom-8"
  aria-label="Scroll to services section"
  data-hero-scroll
>
  <span class="text-label tracking-[0.14em]">Scroll</span>
  <span
    class="flex size-8 items-center justify-center rounded-full border border-border bg-white/5 backdrop-blur-sm transition-transform duration-200 group-hover:translate-y-0.5"
    data-scroll-bounce
  >
    <ChevronDown class="size-4" aria-hidden="true" />
  </span>
</a>

<script>
  import { bootWhenVisible } from '@/lib/bootWhenVisible';
  import { shouldRunAmbient } from '@/lib/motionBudget';

  let dispose: (() => void) | undefined;

  function schedule(): void {
    dispose?.();
    dispose = bootWhenVisible(
      '[data-hero-scroll]',
      async (root) => {
        if (!shouldRunAmbient()) return;
        const bounce = root.querySelector<HTMLElement>('[data-scroll-bounce]');
        if (!bounce) return;
        const { gsap } = await import('@/lib/gsap');
        gsap.to(bounce, {
          y: 6,
          duration: 1.1,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });
      },
      { idle: true, idleTimeout: 1200 },
    );
  }

  schedule();
  document.addEventListener('astro:page-load', schedule);
</script>
