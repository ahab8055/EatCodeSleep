---
/**
 * Ambient hero atmosphere: animated gradients, drifting grid, noise, aurora, particles.
 */
const particles = [
  { left: '14%', top: '24%', d: '13s', delay: '0s' },
  { left: '36%', top: '62%', d: '16s', delay: '0.8s' },
  { left: '58%', top: '18%', d: '12s', delay: '1.4s' },
  { left: '76%', top: '48%', d: '15s', delay: '0.3s' },
  { left: '88%', top: '72%', d: '17s', delay: '1.1s' },
  { left: '22%', top: '78%', d: '14s', delay: '1.8s' },
] as const;
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-bg-base absolute inset-0"></div>
  <div class="hero-bg-aurora absolute inset-0"></div>
  <div class="hero-bg-grid absolute inset-0 opacity-[0.28]"></div>
  <div class="hero-bg-noise absolute inset-0 opacity-[0.35] mix-blend-overlay"></div>

  {
    particles.map((p) => (
      <span
        class="hero-bg-particle"
        style={`left:${p.left};top:${p.top};--d:${p.d};--delay:${p.delay}`}
      />
    ))
  }

  <div
    class="absolute -left-24 top-16 size-[28rem] rounded-full bg-primary/25 blur-[120px] gpu md:size-[36rem]"
    data-hero-glow
    data-parallax
    data-parallax-speed="0.12"
  >
  </div>
  <div
    class="absolute -right-16 top-1/3 size-[24rem] rounded-full bg-secondary/20 blur-[110px] gpu md:size-[32rem]"
    data-hero-glow
    data-parallax
    data-parallax-speed="0.08"
  >
  </div>
  <div
    class="absolute bottom-0 left-1/3 size-[20rem] rounded-full bg-accent/10 blur-[100px] gpu"
    data-hero-glow
    data-parallax
    data-parallax-speed="0.15"
  >
  </div>
</div>

<style>
  .hero-bg-base {
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, rgb(79 70 229 / 0.18), transparent 55%),
      radial-gradient(ellipse 70% 45% at 80% 30%, rgb(6 182 212 / 0.12), transparent 50%),
      radial-gradient(ellipse 60% 40% at 50% 100%, rgb(34 197 94 / 0.06), transparent 55%),
      linear-gradient(180deg, #050816 0%, #0b1023 55%, #050816 100%);
  }

  .hero-bg-aurora {
    background:
      radial-gradient(ellipse 40% 30% at 30% 20%, rgb(79 70 229 / 0.28), transparent 60%),
      radial-gradient(ellipse 35% 28% at 75% 35%, rgb(6 182 212 / 0.2), transparent 55%);
    filter: blur(20px);
    animation: hero-aurora 16s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .hero-bg-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);
    animation: hero-grid-move 36s linear infinite;
  }

  .hero-bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    animation: hero-noise 7s steps(5) infinite;
  }

  .hero-bg-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.5);
    box-shadow: 0 0 8px rgb(6 182 212 / 0.4);
    animation: hero-particle var(--d, 14s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  @keyframes hero-aurora {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.75;
    }
    to {
      transform: translate3d(3%, -2%, 0) scale(1.08);
      opacity: 1;
    }
  }

  @keyframes hero-grid-move {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 64px 64px;
    }
  }

  @keyframes hero-noise {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-1%, 1%);
    }
  }

  @keyframes hero-particle {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 0.25;
    }
    50% {
      transform: translate3d(10px, -26px, 0);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-aurora,
    .hero-bg-grid,
    .hero-bg-noise,
    .hero-bg-particle {
      animation: none;
    }
  }
</style>
