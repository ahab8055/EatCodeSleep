---
/**
 * Premium browser mockups with loading, charts, and UI motion.
 */
import { cn } from '@/lib/cn';
import type { ProjectMockupVariant } from '@/types/work';

export interface Props {
  variant: ProjectMockupVariant;
  alt: string;
  class?: string;
}

const { variant, alt, class: className }: Props = Astro.props;

const titles: Record<ProjectMockupVariant, string> = {
  'ai-workflow': 'app.eatcodesleep.ai/dashboard',
  healthcare: 'care.platform/overview',
  fintech: 'insights.ledger/forecast',
};
---

<div
  class={cn('project-mockup relative aspect-[4/3] w-full overflow-hidden', className)}
  role="img"
  aria-label={alt}
  data-project-mockup={variant}
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-primary/20 via-background-secondary to-secondary/10"
    aria-hidden="true"
  >
  </div>
  <div class="project-mockup__grid absolute inset-0 opacity-30" aria-hidden="true"></div>

  <div
    class="absolute inset-3 flex flex-col overflow-hidden rounded-[var(--radius-ds)] border border-border bg-background-card/90 shadow-[0_28px_70px_rgb(0_0_0_/0.5)] backdrop-blur-xl sm:inset-4 md:inset-6"
    aria-hidden="true"
  >
    <div class="flex shrink-0 items-center gap-2 border-b border-border bg-background-secondary/60 px-3 py-2.5">
      <span class="size-2.5 rounded-full bg-red-400/80"></span>
      <span class="size-2.5 rounded-full bg-amber-300/80"></span>
      <span class="size-2.5 rounded-full bg-accent/80"></span>
      <div
        class="ml-2 flex min-w-0 flex-1 items-center rounded-md border border-border bg-white/[0.04] px-2.5 py-1"
      >
        <span class="truncate font-mono text-[10px] text-muted sm:text-[11px]">{titles[variant]}</span>
      </div>
    </div>

    {
      variant === 'ai-workflow' && (
        <div class="relative flex min-h-0 flex-1 flex-col gap-3 p-3 sm:p-4">
          <div class="flex items-center justify-between gap-2">
            <p class="font-display text-sm text-foreground sm:text-base">Dashboard</p>
            <span class="project-mockup__live inline-flex items-center gap-1.5 rounded-full bg-accent/15 px-2 py-0.5 text-[10px] text-accent">
              <span class="size-1.5 rounded-full bg-accent" />
              syncing
            </span>
          </div>

          <div class="project-mockup__assistant rounded-lg border border-primary/30 bg-primary/10 p-3">
            <p class="text-[10px] uppercase tracking-[0.12em] text-secondary">AI Assistant</p>
            <p class="mt-1 text-xs text-foreground">Routing 128 jobs · RAG online</p>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
              <div class="project-mockup__bar h-full w-[72%] rounded-full bg-gradient-to-r from-primary to-secondary" />
            </div>
          </div>

          <div class="mt-auto grid grid-cols-2 gap-2">
            <div class="rounded-lg border border-border bg-white/[0.04] p-2.5">
              <p class="text-[10px] text-muted">Analytics</p>
              <div class="project-mockup__chart mt-2 flex h-10 items-end gap-1">
                <span style="--h: 40%" />
                <span style="--h: 65%" />
                <span style="--h: 48%" />
                <span style="--h: 82%" />
                <span style="--h: 70%" />
                <span style="--h: 95%" />
              </div>
            </div>
            <div class="rounded-lg border border-border bg-white/[0.04] p-2.5">
              <p class="text-[10px] text-muted">Automation</p>
              <ul class="mt-2 space-y-1.5 text-[10px] text-muted">
                <li class="project-mockup__row flex items-center gap-1.5">
                  <span class="size-1 rounded-full bg-secondary" />
                  Ingest queue
                </li>
                <li class="project-mockup__row flex items-center gap-1.5" style="--d: 0.2s">
                  <span class="size-1 rounded-full bg-primary" />
                  Agent routing
                </li>
                <li class="project-mockup__row flex items-center gap-1.5" style="--d: 0.4s">
                  <span class="size-1 rounded-full bg-accent" />
                  CRM sync
                </li>
              </ul>
            </div>
          </div>
        </div>
      )
    }

    {
      variant === 'healthcare' && (
        <div class="relative flex min-h-0 flex-1 flex-col gap-3 p-3 sm:p-4">
          <div class="flex items-center justify-between">
            <p class="font-display text-sm text-foreground">Patient overview</p>
            <span class="rounded-full bg-accent/15 px-2 py-0.5 text-[10px] text-accent">secure</span>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div class="rounded-lg border border-border bg-white/[0.04] p-2">
              <p class="text-[9px] text-muted">Active</p>
              <p class="project-mockup__metric font-display text-sm text-foreground">1,284</p>
            </div>
            <div class="rounded-lg border border-border bg-white/[0.04] p-2">
              <p class="text-[9px] text-muted">Appts</p>
              <p class="project-mockup__metric font-display text-sm text-foreground" style="--d: 0.15s">
                86
              </p>
            </div>
            <div class="rounded-lg border border-border bg-white/[0.04] p-2">
              <p class="text-[9px] text-muted">Alerts</p>
              <p class="project-mockup__metric font-display text-sm text-secondary" style="--d: 0.3s">
                3
              </p>
            </div>
          </div>
          <div class="space-y-2">
            <div class="h-2 overflow-hidden rounded-full bg-white/10">
              <div class="project-mockup__bar h-full w-2/3 rounded-full bg-secondary/70" />
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-white/10">
              <div class="project-mockup__bar h-full w-1/2 rounded-full bg-primary/70" style="--d: 0.2s" />
            </div>
          </div>
          <ul class="mt-auto space-y-1.5 text-[10px]">
            <li class="project-mockup__row flex items-center gap-2 text-foreground">
              <span class="size-1.5 rounded-full bg-accent" />
              Intake completed
            </li>
            <li class="project-mockup__row flex items-center gap-2 text-muted" style="--d: 0.25s">
              <span class="size-1.5 rounded-full bg-secondary" />
              Labs reviewed
            </li>
            <li class="project-mockup__row flex items-center gap-2 text-muted" style="--d: 0.5s">
              <span class="size-1.5 rounded-full bg-primary" />
              Follow-up scheduled
            </li>
          </ul>
        </div>
      )
    }

    {
      variant === 'fintech' && (
        <div class="relative flex min-h-0 flex-1 flex-col gap-3 p-3 sm:p-4">
          <div class="flex items-center justify-between">
            <p class="font-display text-sm text-foreground">Revenue forecast</p>
            <span class="text-[10px] text-accent">+18.4%</span>
          </div>
          <svg class="project-mockup__svg h-24 w-full" viewBox="0 0 200 80" fill="none">
            <defs>
              <linearGradient id="fintech-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#4F46E5" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path
              class="project-mockup__area"
              d="M0 60 C 30 55, 45 35, 70 40 S 120 20, 150 28 S 180 18, 200 22 L 200 80 L 0 80 Z"
              fill="url(#fintech-fill)"
            />
            <path
              class="project-mockup__path"
              d="M0 60 C 30 55, 45 35, 70 40 S 120 20, 150 28 S 180 18, 200 22"
              stroke="#06B6D4"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <div class="mt-auto grid grid-cols-2 gap-2">
            <div class="rounded-lg border border-border bg-white/[0.04] p-2.5">
              <p class="text-[10px] text-muted">Cash runway</p>
              <p class="font-display text-lg text-foreground">18 mo</p>
            </div>
            <div class="rounded-lg border border-border bg-white/[0.04] p-2.5">
              <p class="text-[10px] text-muted">Stripe volume</p>
              <p class="font-display text-lg text-foreground">$2.4M</p>
            </div>
          </div>
          <div class="absolute right-3 top-12 rounded-md border border-border bg-white/5 px-2 py-1 font-mono text-[9px] text-muted backdrop-blur-md">
            GET /v1/insights
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .project-mockup__grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black, transparent);
  }

  .project-mockup__live span {
    animation: mock-pulse 1.5s ease-in-out infinite;
  }

  .project-mockup__bar {
    transform-origin: left center;
    animation: mock-grow 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0s);
  }

  .project-mockup__chart span {
    display: block;
    flex: 1;
    height: var(--h);
    border-radius: 2px;
    background: linear-gradient(180deg, #4f46e5, #06b6d4);
    opacity: 0.85;
    transform-origin: bottom;
    animation: mock-bar 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .project-mockup__chart span:nth-child(1) {
    animation-delay: 0.05s;
  }
  .project-mockup__chart span:nth-child(2) {
    animation-delay: 0.1s;
  }
  .project-mockup__chart span:nth-child(3) {
    animation-delay: 0.15s;
  }
  .project-mockup__chart span:nth-child(4) {
    animation-delay: 0.2s;
  }
  .project-mockup__chart span:nth-child(5) {
    animation-delay: 0.25s;
  }
  .project-mockup__chart span:nth-child(6) {
    animation-delay: 0.3s;
  }

  .project-mockup__row {
    animation: mock-fade 0.6s ease both;
    animation-delay: var(--d, 0s);
  }

  .project-mockup__metric {
    animation: mock-fade 0.7s ease both;
    animation-delay: var(--d, 0s);
  }

  .project-mockup__path {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: mock-draw 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards 0.2s;
  }

  .project-mockup__area {
    opacity: 0;
    animation: mock-fade 0.8s ease forwards 0.6s;
  }

  .project-mockup__assistant {
    animation: mock-slide 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes mock-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @keyframes mock-grow {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes mock-bar {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes mock-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @keyframes mock-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes mock-slide {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-mockup__live span,
    .project-mockup__bar,
    .project-mockup__chart span,
    .project-mockup__row,
    .project-mockup__metric,
    .project-mockup__path,
    .project-mockup__area,
    .project-mockup__assistant {
      animation: none;
      opacity: 1;
      transform: none;
      stroke-dashoffset: 0;
    }
  }
</style>
