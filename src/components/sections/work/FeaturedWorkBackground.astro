---
/**
 * Soft atmosphere for Featured Work.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="work-bg-base absolute inset-0"></div>
  <div class="work-bg-grid absolute inset-0 opacity-[0.15]"></div>

  <div
    class="absolute right-[-12%] top-[10%] size-[30rem] rounded-full bg-primary/12 blur-[120px] gpu md:size-[40rem]"
    data-work-glow
  >
  </div>
  <div
    class="absolute bottom-[8%] left-[-10%] size-[24rem] rounded-full bg-secondary/10 blur-[110px] gpu"
    data-work-glow
  >
  </div>
</div>

<style>
  .work-bg-base {
    background:
      radial-gradient(ellipse 60% 40% at 80% 15%, rgb(79 70 229 / 0.12), transparent 55%),
      radial-gradient(ellipse 50% 35% at 15% 75%, rgb(6 182 212 / 0.08), transparent 50%),
      linear-gradient(180deg, #050816 0%, #0b1023 45%, #050816 100%);
  }

  .work-bg-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 15%, transparent 75%);
  }
</style>
