---
/**
 * Cinematic atmosphere for the Final CTA.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="final-cta-bg absolute inset-0"></div>
  <div class="final-cta-grid absolute inset-0 opacity-[0.18]"></div>
  <div class="final-cta-noise absolute inset-0 opacity-[0.3] mix-blend-overlay"></div>

  <div
    class="absolute left-1/2 top-1/4 size-[28rem] -translate-x-1/2 rounded-full bg-primary/25 blur-[130px] gpu md:size-[42rem]"
    data-cta-glow
  >
  </div>
  <div
    class="absolute -left-16 bottom-1/4 size-[22rem] rounded-full bg-secondary/15 blur-[110px] gpu md:size-[30rem]"
    data-cta-glow
  >
  </div>
  <div
    class="absolute -right-10 top-[15%] size-[20rem] rounded-full bg-accent/10 blur-[100px] gpu"
    data-cta-glow
  >
  </div>

  <span class="final-cta-particle final-cta-particle-1" data-cta-particle></span>
  <span class="final-cta-particle final-cta-particle-2" data-cta-particle></span>
  <span class="final-cta-particle final-cta-particle-3" data-cta-particle></span>
  <span class="final-cta-particle final-cta-particle-4" data-cta-particle></span>
  <span class="final-cta-particle final-cta-particle-5" data-cta-particle></span>
  <span class="final-cta-particle final-cta-particle-6" data-cta-particle></span>
</div>

<style>
  .final-cta-bg {
    background:
      radial-gradient(ellipse 70% 50% at 50% 35%, rgb(79 70 229 / 0.22), transparent 55%),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgb(6 182 212 / 0.1), transparent 50%),
      radial-gradient(ellipse 45% 35% at 85% 70%, rgb(34 197 94 / 0.06), transparent 50%),
      linear-gradient(180deg, #050816 0%, #0b1023 45%, #050816 100%);
  }

  .final-cta-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 65% 55% at 50% 45%, black 20%, transparent 75%);
  }

  .final-cta-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }

  .final-cta-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.4);
    transform: translateZ(0);
  }

  .final-cta-particle-1 {
    left: 12%;
    top: 28%;
    opacity: 0.3;
  }
  .final-cta-particle-2 {
    left: 28%;
    top: 62%;
    opacity: 0.22;
  }
  .final-cta-particle-3 {
    left: 48%;
    top: 18%;
    opacity: 0.28;
  }
  .final-cta-particle-4 {
    left: 66%;
    top: 48%;
    opacity: 0.2;
  }
  .final-cta-particle-5 {
    left: 82%;
    top: 30%;
    opacity: 0.26;
  }
  .final-cta-particle-6 {
    left: 88%;
    top: 72%;
    opacity: 0.18;
  }

  @media (max-width: 767px) {
    .final-cta-grid,
    .final-cta-noise {
      opacity: 0.1;
    }
  }
</style>
