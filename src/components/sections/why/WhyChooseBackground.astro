---
/**
 * Soft atmosphere for Why Choose section.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="why-bg-base absolute inset-0"></div>
  <div class="why-bg-grid absolute inset-0 opacity-[0.15]"></div>

  <div
    class="absolute left-[-8%] top-[18%] size-[28rem] rounded-full bg-primary/12 blur-[120px] gpu md:size-[36rem]"
    data-why-glow
  >
  </div>
  <div
    class="absolute right-[-10%] bottom-[12%] size-[24rem] rounded-full bg-secondary/10 blur-[110px] gpu"
    data-why-glow
  >
  </div>

  <span class="why-particle why-particle-1" data-why-particle></span>
  <span class="why-particle why-particle-2" data-why-particle></span>
  <span class="why-particle why-particle-3" data-why-particle></span>
  <span class="why-particle why-particle-4" data-why-particle></span>
</div>

<style>
  .why-bg-base {
    background:
      radial-gradient(ellipse 55% 40% at 15% 25%, rgb(79 70 229 / 0.12), transparent 55%),
      radial-gradient(ellipse 50% 35% at 85% 75%, rgb(6 182 212 / 0.08), transparent 50%),
      linear-gradient(180deg, #050816 0%, #0b1023 48%, #050816 100%);
  }

  .why-bg-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 15%, transparent 75%);
  }

  .why-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.35);
    transform: translateZ(0);
  }

  .why-particle-1 {
    left: 18%;
    top: 28%;
    opacity: 0.26;
  }
  .why-particle-2 {
    left: 42%;
    top: 62%;
    opacity: 0.2;
  }
  .why-particle-3 {
    left: 68%;
    top: 22%;
    opacity: 0.24;
  }
  .why-particle-4 {
    left: 84%;
    top: 70%;
    opacity: 0.18;
  }
</style>
