---
import { Cpu, GitBranch, Handshake, Rocket, ShieldCheck, Sparkles } from '@lucide/astro';
import { cn } from '@/lib/cn';
import type { ValueCardItem, ValueIconName } from '@/types/why';

export interface Props {
  item: ValueCardItem;
  class?: string;
}

const { item, class: className }: Props = Astro.props;

const icons: Record<ValueIconName, typeof Rocket> = {
  rocket: Rocket,
  'shield-check': ShieldCheck,
  cpu: Cpu,
  'git-branch': GitBranch,
  handshake: Handshake,
  sparkles: Sparkles,
};

const Icon = icons[item.icon];
---

<article
  class={cn(
    'value-card group relative h-full overflow-hidden rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-6 backdrop-blur-xl transition-[transform,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:border-white/15 hover:shadow-[0_20px_50px_rgb(0_0_0_/0.35),0_0_40px_rgb(79_70_229_/0.12)] sm:p-7',
    className,
  )}
  data-value-card
>
  <div
    class="value-card__glow pointer-events-none absolute -right-10 -top-10 size-40 rounded-full bg-primary/15 blur-3xl opacity-60 transition-opacity duration-300 group-hover:opacity-100"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10">
    <div
      class="mb-5 inline-flex size-12 items-center justify-center rounded-[calc(var(--radius-ds)-4px)] border border-border bg-white/5 text-secondary transition-transform duration-300 ease-out group-hover:rotate-6"
    >
      <Icon class="size-5" aria-hidden="true" />
    </div>

    <h3 class="font-display text-xl tracking-tight text-foreground">
      {item.title}
    </h3>

    <div
      class="value-card__divider mt-4 h-px w-8 bg-gradient-to-r from-secondary to-transparent transition-[width] duration-300 ease-out group-hover:w-16"
      aria-hidden="true"
    >
    </div>

    <p class="text-body mt-4 text-pretty">
      {item.description}
    </p>
  </div>
</article>
