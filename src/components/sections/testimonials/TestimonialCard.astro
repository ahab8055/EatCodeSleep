---
import { Star } from '@lucide/astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import { cn } from '@/lib/cn';
import type { Testimonial } from '@/types/testimonials';

export interface Props {
  testimonial: Testimonial;
  class?: string;
}

const { testimonial, class: className }: Props = Astro.props;
const stars = Array.from({ length: testimonial.rating }, (_, index) => index);
---

<article
  class={cn(
    'flex h-full flex-col rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-6 backdrop-blur-xl sm:p-7',
    className,
  )}
  data-testimonial-card
>
  <div class="flex items-center gap-3">
    <div
      class="flex size-11 shrink-0 items-center justify-center rounded-full border border-border bg-white/5 font-display text-sm text-foreground"
      role="img"
      aria-label={testimonial.avatarAlt}
    >
      {testimonial.avatarInitials}
    </div>
    <div class="min-w-0">
      <p class="font-medium text-foreground">{testimonial.name}</p>
      <p class="text-xs text-muted">
        {testimonial.role}, {testimonial.company}
      </p>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-1" aria-label={`${testimonial.rating} out of 5 stars`}>
    {
      stars.map(() => (
        <Star class="size-3.5 fill-secondary text-secondary" aria-hidden="true" />
      ))
    }
  </div>

  <blockquote class="text-body mt-4 flex-1 text-pretty">
    “{testimonial.quote}”
  </blockquote>

  <div class="mt-6 border-t border-border pt-4">
    <p class="text-label normal-case tracking-normal text-muted">{testimonial.project}</p>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Technologies used">
      {
        testimonial.technologies.map((tech) => (
          <li>
            <TechBadge>{tech}</TechBadge>
          </li>
        ))
      }
    </ul>
  </div>
</article>
