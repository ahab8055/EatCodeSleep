---
/**
 * Soft atmosphere for the Services section.
 * Decorative only — hidden from assistive tech.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="services-bg-base absolute inset-0"></div>
  <div class="services-bg-grid absolute inset-0 opacity-[0.18]"></div>

  <div
    class="absolute left-1/2 top-0 size-[36rem] -translate-x-1/2 rounded-full bg-primary/15 blur-[120px] gpu md:size-[44rem]"
    data-services-glow
  >
  </div>
  <div
    class="absolute -right-24 bottom-10 size-[22rem] rounded-full bg-secondary/10 blur-[100px] gpu"
    data-services-glow
  >
  </div>

  <span class="services-particle services-particle-1" data-services-particle></span>
  <span class="services-particle services-particle-2" data-services-particle></span>
  <span class="services-particle services-particle-3" data-services-particle></span>
  <span class="services-particle services-particle-4" data-services-particle></span>
  <span class="services-particle services-particle-5" data-services-particle></span>
  <span class="services-particle services-particle-6" data-services-particle></span>
</div>

<style>
  .services-bg-base {
    background:
      radial-gradient(ellipse 70% 45% at 50% 0%, rgb(79 70 229 / 0.14), transparent 55%),
      radial-gradient(ellipse 50% 40% at 90% 80%, rgb(6 182 212 / 0.08), transparent 50%),
      linear-gradient(180deg, #050816 0%, #0b1023 48%, #050816 100%);
  }

  .services-bg-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, black 15%, transparent 75%);
  }

  .services-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.35);
    transform: translateZ(0);
  }

  .services-particle-1 {
    left: 12%;
    top: 22%;
    opacity: 0.3;
  }
  .services-particle-2 {
    left: 28%;
    top: 68%;
    opacity: 0.22;
  }
  .services-particle-3 {
    left: 54%;
    top: 18%;
    opacity: 0.28;
  }
  .services-particle-4 {
    left: 72%;
    top: 42%;
    opacity: 0.2;
  }
  .services-particle-5 {
    left: 86%;
    top: 72%;
    opacity: 0.26;
  }
  .services-particle-6 {
    left: 40%;
    top: 82%;
    opacity: 0.18;
  }
</style>
