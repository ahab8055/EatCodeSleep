---
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ServiceCard from '@/components/sections/services/ServiceCard.astro';
import ServicesBackground from '@/components/sections/services/ServicesBackground.astro';
import { services, servicesSection } from '@/data/services';
---

<Section
  id="services"
  spacing="xl"
  class="scroll-mt-20 overflow-hidden"
  ariaLabelledby="services-heading"
>
  <ServicesBackground />

  <Container class="relative z-10">
    <SectionHeading
      label={servicesSection.label}
      heading={servicesSection.headingLines}
      description={servicesSection.description}
      headingId="services-heading"
      size="lg"
      class="mb-10 md:mb-12"
    />

    <ul
      class="grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 md:gap-6"
      role="list"
      aria-label="Services offered by EatCodeSleep"
    >
      {
        services.map((service) => (
          <li class="min-w-0">
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>
  </Container>
</Section>

<script>
  import { bootWhenVisible } from '@/lib/bootWhenVisible';
  import { shouldRunAmbient } from '@/lib/motionBudget';

  let dispose: (() => void) | undefined;

  function schedule(): void {
    dispose?.();
    dispose = bootWhenVisible('#services', async (root) => {
      const [{ playServicesEntrance }, { initServiceCardTilt }] = await Promise.all([
        import('@/lib/services-animations'),
        import('@/lib/service-card-tilt'),
      ]);

      playServicesEntrance(root);
      initServiceCardTilt(root);

      if (!shouldRunAmbient()) return;

      const { gsap } = await import('@/lib/gsap');
      const glows = root.querySelectorAll<HTMLElement>('[data-services-glow]');
      const particles = root.querySelectorAll<HTMLElement>('[data-services-particle]');

      glows.forEach((el, index) => {
        gsap.to(el, {
          x: index % 2 === 0 ? 24 : -20,
          y: index % 2 === 0 ? -18 : 22,
          duration: 9 + index,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });
      });

      particles.forEach((el, index) => {
        gsap.to(el, {
          y: -12 - (index % 3) * 4,
          opacity: 0.12,
          duration: 3.2 + index * 0.25,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
          delay: index * 0.12,
        });
      });
    });
  }

  schedule();
  document.addEventListener('astro:page-load', schedule);
</script>
