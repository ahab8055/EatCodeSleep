---
import { Clock, CodeXml, Mail } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import { faqSidebar } from '@/data/faqs';
import { cn } from '@/lib/cn';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

const icons = {
  mail: Mail,
  clock: Clock,
  code: CodeXml,
} as const;
---

<aside
  class={cn('lg:sticky lg:top-28', className)}
  data-faq-sidebar
  aria-label="Project inquiry"
>
  <div
    class="rounded-[var(--radius-ds)] border border-border bg-background-card/60 p-6 backdrop-blur-xl sm:p-7 md:p-8"
  >
    <Heading as={3} size="sm" balance={false}>
      {faqSidebar.title}
    </Heading>

    <p class="text-body mt-3 text-pretty">
      {faqSidebar.description}
    </p>

    <div class="mt-6 flex flex-col gap-3">
      <Button href={faqSidebar.primaryCta.href} class="w-full justify-center">
        {faqSidebar.primaryCta.label}
      </Button>
      <Button
        href={faqSidebar.secondaryCta.href}
        variant="secondary"
        showArrow={false}
        class="w-full justify-center"
      >
        {faqSidebar.secondaryCta.label}
      </Button>
    </div>

    <ul class="mt-8 space-y-3" role="list">
      {
        faqSidebar.indicators.map((indicator) => {
          const Icon = icons[indicator.icon];

          return (
            <li class="flex items-center gap-3 text-sm text-muted">
              <span
                class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-border bg-white/5 text-secondary"
                aria-hidden="true"
              >
                <Icon class="size-3.5" />
              </span>
              <span>{indicator.label}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</aside>
