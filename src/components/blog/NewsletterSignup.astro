---
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import BlogBackground from '@/components/blog/BlogBackground.astro';
import { blogNewsletter } from '@/data/blog';
---

<Section
  id="newsletter"
  spacing="xl"
  class="scroll-mt-28 overflow-hidden"
  ariaLabelledby="blog-newsletter-heading"
  data-blog-newsletter
>
  <BlogBackground />

  <Container class="relative z-10">
    <div
      class="mx-auto max-w-2xl rounded-[var(--radius-ds)] border border-border bg-background-card/55 px-6 py-10 text-center shadow-[0_0_50px_rgb(79_70_229_/0.12)] backdrop-blur-xl sm:px-10 sm:py-12"
      data-newsletter-panel
    >
      <h2
        id="blog-newsletter-heading"
        class="font-display text-2xl tracking-tight text-foreground md:text-3xl"
      >
        {blogNewsletter.heading}
      </h2>
      <p class="text-body mx-auto mt-4 max-w-lg text-pretty">
        {blogNewsletter.description}
      </p>

      <form
        class="mt-8 flex flex-col gap-3 sm:flex-row"
        method="post"
        action="/newsletter"
        data-newsletter-form
      >
        <label class="sr-only" for="blog-newsletter-email">Email address</label>
        <input
          id="blog-newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={blogNewsletter.placeholder}
          class="min-w-0 flex-1 rounded-[var(--radius-ds)] border border-border bg-white/5 px-4 py-3 text-sm text-foreground placeholder:text-muted transition-colors duration-200 focus:border-secondary/50 focus:outline-none focus:ring-2 focus:ring-secondary/40"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-[var(--radius-ds)] bg-primary px-5 py-3 text-sm font-medium text-foreground transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow-button-lift)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {blogNewsletter.buttonLabel}
        </button>
      </form>
    </div>
  </Container>
</Section>
