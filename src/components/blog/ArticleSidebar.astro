---
import Button from '@/components/ui/Button.astro';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings?: TocHeading[];
}

const { headings = [] }: Props = Astro.props;
const tocItems = headings.filter((heading) => heading.depth <= 3);
---

<aside class="space-y-6" aria-label="Article sidebar" data-article-sidebar>
  <section
    class="rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-5 backdrop-blur-xl"
    aria-labelledby="toc-heading"
  >
    <h2 id="toc-heading" class="font-display text-lg tracking-tight text-foreground">
      On this page
    </h2>
    <nav class="mt-4" aria-label="Table of contents">
      {
        tocItems.length > 0 ? (
          <ul class="space-y-2" data-toc-list>
            {tocItems.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="block text-sm text-muted transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-muted">No sections available.</p>
        )
      }
    </nav>
  </section>

  <section
    class="rounded-[var(--radius-ds)] border border-border bg-background-card/55 p-5 backdrop-blur-xl"
    aria-labelledby="article-cta-heading"
  >
    <h2 id="article-cta-heading" class="font-display text-lg tracking-tight text-foreground">
      Build with us
    </h2>
    <p class="text-body-sm mt-2 text-pretty">
      Turning insights into production systems is what we do every day.
    </p>
    <div class="mt-4">
      <Button href="/contact/" size="sm" class="w-full">
        Start a Project
      </Button>
    </div>
  </section>
</aside>
