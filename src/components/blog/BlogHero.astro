---
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import BlogBackground from '@/components/blog/BlogBackground.astro';
import BlogHeroVisual from '@/components/blog/BlogHeroVisual.astro';
import { blogHero } from '@/data/blog';
---

<section
  id="blog-hero"
  class="relative flex min-h-[70svh] items-center overflow-hidden pt-16 md:min-h-[80svh] md:pt-20"
  aria-labelledby="blog-hero-heading"
  data-blog-hero
>
  <BlogBackground />

  <Container class="relative z-10 w-full py-12 md:py-16 lg:py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-xl">
        <p class="text-label text-secondary" data-blog-hero-label>{blogHero.label}</p>

        <Heading as={1} size="display" id="blog-hero-heading" class="mt-5 md:mt-6" balance={false}>
          {
            blogHero.headingLines.map((line) => (
              <span class="block overflow-hidden">
                <span class="block" data-blog-hero-line>
                  {line}
                </span>
              </span>
            ))
          }
        </Heading>

        <p class="text-body-lg mt-6 max-w-[34rem] text-pretty md:mt-8" data-blog-hero-copy>
          {blogHero.description}
        </p>
      </div>

      <BlogHeroVisual />
    </div>
  </Container>
</section>
