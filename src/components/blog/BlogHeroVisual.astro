---
const panels = [
  { title: 'Snippet', lines: ['const agent =', '  plan(goal)', '  .act()'] },
  { title: 'AI Flow', lines: ['Intent', 'Retrieve', 'Respond'] },
  { title: 'Architecture', lines: ['Edge', 'API', 'Data'] },
  { title: 'Notes', lines: ['Measure first', 'Ship small', 'Iterate'] },
] as const;
---

<div
  class="relative mx-auto w-full max-w-md"
  data-blog-hero-visual
  data-blog-float
  aria-hidden="true"
>
  <div
    class="absolute left-1/2 top-1/2 size-[70%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/18 blur-[90px]"
    data-blog-glow
  >
  </div>

  <div class="relative grid gap-3 sm:grid-cols-2">
    {
      panels.map((panel, index) => (
        <div
          class:list={[
            'rounded-[var(--radius-ds)] border border-border bg-background-card/60 p-4 backdrop-blur-xl',
            index % 2 === 1 && 'sm:translate-y-4',
          ]}
        >
          <p class="text-label mb-3 text-secondary">{panel.title}</p>
          <ul class="space-y-1.5">
            {panel.lines.map((line) => (
              <li class="rounded-lg border border-border bg-white/[0.03] px-2.5 py-1.5 font-mono text-[0.7rem] text-muted">
                {line}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>
