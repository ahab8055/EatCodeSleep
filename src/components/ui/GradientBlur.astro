---
import { cn } from '@/lib/cn';

export interface Props {
  class?: string;
  color?: 'primary' | 'secondary' | 'accent';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  blur?: 'sm' | 'md' | 'lg' | 'xl';
  intensity?: 'soft' | 'medium' | 'strong';
}

const {
  class: className,
  color = 'primary',
  size = 'lg',
  blur = 'xl',
  intensity = 'medium',
}: Props = Astro.props;

const colorClasses = {
  primary: 'bg-primary',
  secondary: 'bg-secondary',
  accent: 'bg-accent',
} as const;

const sizeClasses = {
  sm: 'size-40',
  md: 'size-64',
  lg: 'size-96',
  xl: 'size-[32rem]',
} as const;

const blurClasses = {
  sm: 'blur-2xl',
  md: 'blur-3xl',
  lg: 'blur-[64px]',
  xl: 'blur-[100px]',
} as const;

const intensityClasses = {
  soft: 'opacity-20',
  medium: 'opacity-35',
  strong: 'opacity-50',
} as const;
---

<div
  class={cn(
    'pointer-events-none absolute rounded-full gpu',
    colorClasses[color],
    sizeClasses[size],
    blurClasses[blur],
    intensityClasses[intensity],
    className,
  )}
  aria-hidden="true"
>
</div>
