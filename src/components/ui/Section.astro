---
import { cn } from '@/lib/cn';
import type { SectionSpacing } from '@/types/components';

export interface Props {
  id?: string;
  as?: 'section' | 'div' | 'article';
  class?: string;
  spacing?: SectionSpacing;
  background?: 'primary' | 'secondary' | 'transparent';
  ariaLabelledby?: string;
}

const {
  id,
  as: Tag = 'section',
  class: className,
  spacing = 'lg',
  background = 'transparent',
  ariaLabelledby,
}: Props = Astro.props;

const spacingClasses: Record<SectionSpacing, string> = {
  none: 'py-0',
  sm: 'py-8 md:py-12',
  md: 'py-12 md:py-16',
  lg: 'py-16 md:py-24',
  xl: 'py-24 md:py-32',
};

const backgroundClasses: Record<'primary' | 'secondary' | 'transparent', string> = {
  primary: 'bg-background',
  secondary: 'bg-background-secondary',
  transparent: 'bg-transparent',
};
---

<Tag
  id={id}
  class={cn(spacingClasses[spacing], backgroundClasses[background], 'relative', className)}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</Tag>
