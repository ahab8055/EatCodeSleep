---
import { cn } from '@/lib/cn';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<span
  class={cn(
    'tech-badge inline-flex items-center rounded-full border border-border bg-white/5 px-2.5 py-1 text-xs font-medium text-muted transition-all duration-300 ease-out',
    className,
  )}
  data-tech-badge
>
  <slot />
</span>
