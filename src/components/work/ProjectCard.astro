---
import { ArrowRight } from '@lucide/astro';
import Badge from '@/components/ui/Badge.astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import ProjectVisual from '@/components/work/ProjectVisual.astro';
import { cn } from '@/lib/cn';
import type { WorkProject } from '@/types/projects';

export interface Props {
  project: WorkProject;
  variant?: 'featured' | 'grid';
  reverse?: boolean;
  class?: string;
}

const {
  project,
  variant = 'featured',
  reverse: _reverse = false,
  class: className,
}: Props = Astro.props;

void _reverse;

const isFeatured = variant === 'featured';
---

<article
  id={isFeatured ? undefined : project.id}
  class={cn('project-card group relative', className)}
  data-project-card
  data-project-id={project.id}
  data-case-study-card={variant === 'grid' ? '' : undefined}
  data-filters={variant === 'grid' ? project.filters.join(',') : undefined}
>
  <div
    class={cn(
      'project-card__surface relative overflow-hidden rounded-[var(--radius-ds)] border border-border bg-background-card/55 backdrop-blur-xl transition-[transform,border-color,box-shadow] duration-300 ease-out',
      'group-hover:-translate-y-1 group-hover:border-white/15 group-hover:shadow-[0_28px_90px_rgb(0_0_0_/0.4),0_0_50px_rgb(79_70_229_/0.14)]',
      'shadow-[0_24px_80px_rgb(0_0_0_/0.28)]',
      isFeatured ? 'p-5 sm:p-6 md:p-8 lg:p-10' : 'flex h-full flex-col p-4 sm:p-5',
    )}
  >
    <div
      class="pointer-events-none absolute inset-0 rounded-[var(--radius-ds)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"
    >
      <div class="absolute inset-px rounded-[calc(var(--radius-ds)-1px)] bg-gradient-to-br from-primary/20 via-transparent to-secondary/15"></div>
    </div>

    <div
      class={cn(
        'relative z-10',
        isFeatured && 'flex flex-col gap-8 lg:gap-10',
        !isFeatured && 'flex h-full flex-col',
      )}
    >
      <div
        class={cn(
          'project-card__media overflow-hidden rounded-[calc(var(--radius-ds)-4px)]',
          !isFeatured && 'mb-5',
        )}
        data-project-media
      >
        <div
          class="transition-transform duration-500 ease-out group-hover:scale-[1.01]"
          data-zoom
        >
          <ProjectVisual
            variant={project.visual}
            alt={project.imageAlt}
            mode={isFeatured ? 'gallery' : 'compact'}
          />
        </div>
      </div>

      <div class={cn('min-w-0', !isFeatured && 'flex flex-1 flex-col', isFeatured && 'max-w-3xl')}>
        <Badge variant="secondary" class="normal-case tracking-[0.08em]">
          {project.category}
        </Badge>

        <h3
          class={cn(
            'font-display mt-4 tracking-tight text-foreground',
            isFeatured ? 'text-2xl md:text-3xl' : 'text-xl',
          )}
        >
          {project.title}
        </h3>

        <p class="text-body mt-3 text-pretty">{project.description}</p>

        <ul
          class="mt-5 flex flex-wrap gap-2"
          aria-label={`${project.title} technology stack`}
        >
          {
            project.technologies.map((tech) => (
              <li>
                <TechBadge class="border-white/10 bg-white/[0.07] text-foreground/90 group-hover:border-white/15">
                  {tech}
                </TechBadge>
              </li>
            ))
          }
        </ul>

        <ul class="mt-5 space-y-2" aria-label={`${project.title} outcomes`}>
          {
            project.outcomes.map((outcome) => (
              <li class="text-sm text-secondary">{outcome.label}</li>
            ))
          }
        </ul>

        <a
          href={project.href}
          class="group/link mt-6 inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
        >
          View Case Study
          <ArrowRight
            class="size-4 transition-transform duration-300 group-hover/link:translate-x-1"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</article>
