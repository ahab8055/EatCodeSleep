---
import SocialLinks from '@/components/layout/SocialLinks.astro';
import { footerContent, footerNavColumns } from '@/data/navigation';
import { cn } from '@/lib/cn';
import { withTrailingSlash } from '@/utils/paths';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<nav
  class={cn(
    'grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6',
    className,
  )}
  aria-label="Footer"
>
  {
    footerNavColumns.map((column) => (
      <div data-footer-column>
        <h3 class="footer-nav__title text-label text-foreground">{column.title}</h3>
        <ul class="mt-4 space-y-3" role="list">
          {column.links.map((link) => (
            <li>
              <a href={withTrailingSlash(link.href)} class="footer-nav__link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <div data-footer-column>
    <h3 class="footer-nav__title text-label text-foreground">Contact</h3>
    <ul class="mt-4 space-y-3" role="list">
      <li>
        <a href={`mailto:${footerContent.email}`} class="footer-nav__link normal-case tracking-normal">
          {footerContent.email}
        </a>
      </li>
      <li>
        <p class="text-sm text-muted">{footerContent.location}</p>
      </li>
    </ul>
    <SocialLinks class="mt-5" />
  </div>
</nav>

<style>
  .footer-nav__title {
    letter-spacing: 0.14em;
  }

  .footer-nav__link {
    position: relative;
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 200ms ease;
  }

  .footer-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }

  .footer-nav__link:hover,
  .footer-nav__link:focus-visible {
    color: var(--color-foreground);
  }

  .footer-nav__link:hover::after,
  .footer-nav__link:focus-visible::after {
    transform: scaleX(1);
  }
</style>
