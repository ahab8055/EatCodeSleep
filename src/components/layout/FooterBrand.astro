---
import Logo from '@/components/brand/Logo.astro';
import { footerContent } from '@/data/navigation';
import { cn } from '@/lib/cn';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<div class={cn('relative', className)} data-footer-brand>
  <Logo
    class="footer-brand"
    imgClass="h-auto w-full max-w-sm md:max-w-md lg:max-w-xl"
  />

  <p
    class="text-body mt-6 max-w-[450px] text-pretty md:mt-8"
    data-footer-description
  >
    {footerContent.description}
  </p>
</div>
