---
import { Menu, X } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { siteConfig } from '@/data/site';
import { cn } from '@/lib/cn';
import { withTrailingSlash } from '@/utils/paths';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
const pathname = Astro.url.pathname;

const isActivePath = (href: string) => {
  const target = withTrailingSlash(href);
  if (target === '/') return pathname === '/';
  return pathname === target || pathname.startsWith(target);
};
---

<header
  id="site-header"
  class={cn(
    'fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter,box-shadow] duration-300',
    className,
  )}
  data-navbar
>
  <Container
    as="div"
    class="flex h-16 items-center justify-between gap-4 md:h-20"
  >
    <a
      href="/"
      class="font-display text-lg tracking-tight text-foreground transition-opacity duration-200 hover:opacity-80 md:text-xl"
      aria-label={`${siteConfig.name} home`}
      data-nav-logo
    >
      {siteConfig.name}
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        siteConfig.navigation.map((item) => {
          const href = withTrailingSlash(item.href);
          const isActive = isActivePath(href);

          return (
            <a
              href={href}
              class={cn(
                'rounded-full px-3 py-2 text-sm text-muted transition-colors duration-200 hover:text-foreground',
                isActive && 'text-foreground',
              )}
              aria-current={isActive ? 'page' : undefined}
              data-cursor-hover
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex" data-nav-cta>
      <Button href="/contact/" size="sm" showArrow={false}>
        Book Call
      </Button>
    </div>

    <button
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-[var(--radius-ds)] border border-border text-foreground transition-colors duration-200 hover:bg-white/5 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <Menu class="size-5" data-nav-icon-open aria-hidden="true" />
      <X class="size-5 hidden" data-nav-icon-close aria-hidden="true" />
    </button>
  </Container>

  <div
    id="mobile-nav"
    class="fixed inset-x-0 bottom-0 top-16 z-40 hidden bg-background/95 backdrop-blur-xl md:top-20 lg:hidden"
    data-nav-overlay
    hidden
  >
    <Container as="div" class="flex h-full flex-col gap-8 py-8">
      <nav class="flex flex-col gap-2" aria-label="Mobile">
        {
          siteConfig.navigation.map((item) => {
            const href = withTrailingSlash(item.href);
            const isActive = isActivePath(href);

            return (
              <a
                href={href}
                class={cn(
                  'rounded-[var(--radius-ds)] px-4 py-3 font-display text-2xl text-muted transition-colors duration-200 hover:bg-white/5 hover:text-foreground',
                  isActive && 'text-foreground',
                )}
                aria-current={isActive ? 'page' : undefined}
                data-nav-link
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <Button href="/contact/" size="lg" class="w-full justify-center">
        Book Call
      </Button>
    </Container>
  </div>
</header>

<script>
  import { gsap } from '@/lib/gsap';
  import { getPrefersReducedMotion } from '@/hooks/useReducedMotion';

  const SCROLL_THRESHOLD = 24;

  function initNavbar(): void {
    const header = document.querySelector<HTMLElement>('[data-navbar]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');
    const iconOpen = document.querySelector<HTMLElement>('[data-nav-icon-open]');
    const iconClose = document.querySelector<HTMLElement>('[data-nav-icon-close]');
    const links = document.querySelectorAll<HTMLElement>('[data-nav-link]');
    const logo = document.querySelector<HTMLElement>('[data-nav-logo]');
    const cta = document.querySelector<HTMLElement>('[data-nav-cta]');

    if (!header || !toggle || !overlay) return;

    let menuOpen = false;

    const setScrolled = () => {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;
      header.classList.toggle('border-border', scrolled);
      header.classList.toggle('bg-background/70', scrolled);
      header.classList.toggle('shadow-[0_8px_30px_rgb(0_0_0_/0.25)]', scrolled);
      header.classList.toggle('backdrop-blur-xl', scrolled);
    };

    const setMenuState = (open: boolean) => {
      menuOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      overlay.hidden = !open;
      overlay.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);

      if (getPrefersReducedMotion()) return;

      if (open) {
        gsap.fromTo(
          overlay,
          { opacity: 0 },
          { opacity: 1, duration: 0.25, ease: 'power2.out' },
        );
        gsap.fromTo(
          links,
          { opacity: 0, y: 16 },
          { opacity: 1, y: 0, duration: 0.35, stagger: 0.05, ease: 'power2.out' },
        );
      }
    };

    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });

    toggle.addEventListener('click', () => setMenuState(!menuOpen));
    links.forEach((link) => link.addEventListener('click', () => setMenuState(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuOpen) {
        setMenuState(false);
        toggle.focus();
      }
    });

    if (!getPrefersReducedMotion()) {
      gsap.fromTo(
        [logo, header.querySelector('nav'), cta, toggle].filter(Boolean),
        { opacity: 0, y: -12 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.06,
          ease: 'power2.out',
          delay: 0.05,
        },
      );
    }
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
