---
import { ArrowRight } from '@lucide/astro';
import { footerContent } from '@/data/navigation';
import { cn } from '@/lib/cn';
import { withTrailingSlash } from '@/utils/paths';

export interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
const { cta } = footerContent;
---

<section
  class={cn(
    'flex flex-col items-start justify-between gap-4 rounded-[var(--radius-ds)] border border-border bg-white/[0.03] px-5 py-5 backdrop-blur-md sm:flex-row sm:items-center sm:px-6',
    className,
  )}
  data-footer-cta
  aria-label="Contact call to action"
>
  <p class="font-display text-lg tracking-tight text-foreground sm:text-xl">
    {cta.text}
  </p>

  <a
    href={withTrailingSlash(cta.href)}
    class="group inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors duration-200 hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
  >
    {cta.buttonLabel}
    <ArrowRight
      class="size-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
      aria-hidden="true"
    />
  </a>
</section>
