# Optional Spline embed for the contact hero (published "embed" URL).
# When unset, the lightweight R3F DigitalWorkspace island is used instead.
# PUBLIC_SPLINE_CONTACT_URL=https://my.spline.design/your-scene/embed

# Optional contact form webhook (Formspree / Resend / custom endpoint).
# PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-id

# Google Calendar Appointment Schedule (public booking page).
# Setup:
# 1. Google Calendar → Create → Appointment schedule (e.g. "Discovery Call")
# 2. Set conference to Google Meet
# 3. Configure availability, duration, and buffers
# 4. Copy the public booking link and paste below
# Examples:
#   https://calendar.google.com/calendar/appointments/schedules/...
#   https://calendar.app.google/...
PUBLIC_GOOGLE_BOOKING_URL=
